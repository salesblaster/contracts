{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salesblaster:contracts:conversations:conversation:v1",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": ["email", "voice", "agent_chat", "sms", "in_app", "webchat"]
    },
    "provenance": {
      "type": "string",
      "const": "external"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "external_ref": {
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "lead_id": {
          "type": "string",
          "minLength": 1
        },
        "deep_link_url": {
          "type": "string",
          "minLength": 1
        },
        "last_email_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["thread_id"],
      "additionalProperties": false
    },
    "origin_thread_root_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "last_message_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "archived_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^k(0|[1-9][0-9]*)_[0-9a-f]{32}$"
          },
          "direction": {
            "type": "string",
            "enum": ["inbound", "outbound"]
          },
          "content": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": ["text", "audio", "image", "video"]
          },
          "sender_identifier": {
            "type": "string",
            "minLength": 1
          },
          "sender_display_name": {
            "type": "string",
            "minLength": 1
          },
          "sender_type": {
            "type": "string",
            "minLength": 1
          },
          "occurred_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "via": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "direction",
          "content",
          "format",
          "sender_identifier",
          "sender_type",
          "occurred_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "channel",
    "provenance",
    "provider",
    "external_ref",
    "origin_thread_root_id",
    "created_at",
    "messages"
  ],
  "additionalProperties": false
}
