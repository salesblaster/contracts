{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salesblaster:contracts:conversations:conversation-scope:v1",
  "type": "object",
  "properties": {
    "campaigns": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[A-Za-z0-9_.-]+(?:\\/[A-Za-z0-9_.-]+)*$"
      }
    }
  },
  "required": ["campaigns"],
  "additionalProperties": false
}
