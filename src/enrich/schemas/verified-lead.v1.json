{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salesblaster:contracts:enrich:verified-lead:v1",
  "type": "object",
  "properties": {
    "globalContactId": {
      "type": "string"
    },
    "emailAccountKey": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "companyDomain": {
      "type": "string"
    },
    "linkedinUrl": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["valid", "invalid", "catch_all", "risky", "unknown"]
        },
        "verifiedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      },
      "required": ["status", "verifiedAt"],
      "additionalProperties": false
    }
  },
  "required": ["globalContactId", "emailAccountKey", "email", "verification"],
  "additionalProperties": false
}
