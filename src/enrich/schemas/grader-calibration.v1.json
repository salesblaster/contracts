{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salesblaster:contracts:enrich:grader-calibration:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "graderConfiguration": {
      "type": "object",
      "properties": {
        "enrichmentType": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["id", "version"],
          "additionalProperties": false
        },
        "rubric": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": ["id", "version"],
          "additionalProperties": false
        },
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "contentHash": {
              "type": "string"
            }
          },
          "required": ["name", "version", "contentHash"],
          "additionalProperties": false
        },
        "runtime": {
          "type": "string",
          "enum": ["development", "production"]
        }
      },
      "required": ["enrichmentType", "rubric", "model", "prompt", "runtime"],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterionId": {
            "type": "string"
          },
          "threshold": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          }
        },
        "required": ["criterionId", "threshold"],
        "additionalProperties": false
      }
    },
    "ratifiedBy": {
      "type": "string"
    },
    "ratifiedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "auditRef": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "graderConfiguration",
    "revision",
    "bars",
    "ratifiedBy",
    "ratifiedAt",
    "auditRef"
  ],
  "additionalProperties": false
}
