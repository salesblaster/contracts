{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salesblaster:contracts:enrich:rubric-bands:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "rubricRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["id", "version"],
      "additionalProperties": false
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["schemaVersion", "rubricRef", "bands"],
  "additionalProperties": false
}
