{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salesblaster:contracts:crm:person:v1",
  "type": "object",
  "properties": {
    "external_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "external_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          }
        },
        "required": ["external_id", "kind", "provider"],
        "additionalProperties": false
      }
    },
    "source_changed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "first_name": {
      "type": "string",
      "minLength": 1
    },
    "last_name": {
      "type": "string",
      "minLength": 1
    },
    "full_name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    },
    "phone": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "linkedin_url": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": "string",
      "pattern": "^record:organization\\/k(0|[1-9][0-9]*)_[0-9a-f]{32}$"
    },
    "contact_points": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "email",
              "phone",
              "linkedin",
              "x",
              "whatsapp",
              "github",
              "instagram",
              "facebook",
              "tiktok",
              "youtube",
              "reddit"
            ]
          },
          "handle": {
            "type": "string",
            "pattern": "\\S"
          },
          "provenance": {
            "type": "string",
            "enum": ["observed", "derived", "unknown"]
          },
          "primary": {
            "type": "boolean"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["type", "handle", "provenance"],
        "additionalProperties": false
      }
    }
  },
  "required": ["external_refs", "source_changed_at"],
  "additionalProperties": false
}
