{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salesblaster:contracts:crm:organization:v1",
  "type": "object",
  "properties": {
    "external_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "external_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          }
        },
        "required": ["external_id", "kind", "provider"],
        "additionalProperties": false
      }
    },
    "source_changed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "website": {
      "type": "string",
      "minLength": 1
    },
    "organization_key": {
      "type": "string",
      "pattern": "^(?:ref_key|domain_key|record_key):.+$"
    }
  },
  "required": ["external_refs", "source_changed_at", "name"],
  "additionalProperties": false
}
