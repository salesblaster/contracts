{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salesblaster:contracts:crm:deal:v1",
  "type": "object",
  "properties": {
    "external_refs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "external_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          }
        },
        "required": ["external_id", "kind", "provider"],
        "additionalProperties": false
      }
    },
    "source_changed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pipeline": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["open", "won", "lost"]
    },
    "value": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{3}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    },
    "person": {
      "type": "string",
      "pattern": "^record:person\\/k(0|[1-9][0-9]*)_[0-9a-f]{32}$"
    },
    "organization": {
      "type": "string",
      "pattern": "^record:organization\\/k(0|[1-9][0-9]*)_[0-9a-f]{32}$"
    },
    "labels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cohort": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "external_refs",
    "source_changed_at",
    "pipeline",
    "stage",
    "status"
  ],
  "additionalProperties": false
}
