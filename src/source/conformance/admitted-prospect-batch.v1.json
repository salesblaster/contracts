{
  "conformance": "source.admitted-prospect-batch",
  "version": "1.0.0",
  "status": "ruled",
  "basis": [
    "the admitted-prospect batch's producer invariants"
  ],
  "rule": "1: every prospect has globalContactId, emailAccountKey and email, and emailAccountKey equals key(email). 2: no value is null or an empty string. 3: declaration.fields is present exactly when declaration.fieldSet is declared; when declared, each carried field a prospect holds (email, firstName, lastName, fullName, title, phone, linkedinUrl, companyName, companyDomain) is in declaration.fields, titleFamily appears only if title is, and globalCompanyId only if companyDomain is; globalContactId, emailAccountKey and provenance are not counted. 4: titleFamily is present only when declaration.titleFamilyTable is set, and is one of context.title_family_families, that table's closed families. 5: a prospect has no key outside globalContactId, emailAccountKey, email, firstName, lastName, fullName, title, titleFamily, phone, linkedinUrl, companyName, companyDomain, globalCompanyId and provenance, and provenance holds only acquisitionSource and acquisitionRef. 6: counts.admitted equals the number of prospects, and counts.in equals admitted plus the sum of counts.rejected. 7: emailAccountKey is unique in the batch (how a batch's rows merge is conformance/source/admission-merge.v1.json). 8: every time matches the timestamp pattern. Expect is holds, or the lowest-numbered invariant violated.",
  "vectors": [
    {
      "id": "B-01",
      "input": {
        "batch": {
          "shape": "source.admitted-prospect-batch",
          "schemaVersion": 1,
          "tenantId": "tenant-0001",
          "admissionId": "adm-0001",
          "admittedAt": "2026-11-04T05:00:00.000Z",
          "declaration": {
            "fieldSet": "undeclared"
          },
          "prospects": [
            {
              "globalContactId": "gc-0001",
              "emailAccountKey": "ada@example.com",
              "email": "Ada+acme@Example.com",
              "provenance": {
                "acquisitionSource": "fixture"
              }
            }
          ],
          "counts": {
            "in": 2,
            "admitted": 1,
            "rejected": {
              "no_field_survived_allow_list": 0,
              "no_identifying_field": 0,
              "invalid_email": 1,
              "duplicate_in_batch": 0
            }
          }
        }
      },
      "expect": {
        "holds": true
      },
      "why": "one admitted prospect, one rejection"
    },
