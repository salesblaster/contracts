                "catalogVersion": "1.0.0"
              },
              "operator": "in",
              "value": [
                "GB"
              ]
            },
            {
              "type": "filter",
              "dimension": {
                "name": "employee_count",
                "catalogVersion": "1.0.0"
              },
              "operator": "gte",
              "value": 201
